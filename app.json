{
  "expo": {
    "name": "Freerange",
    "slug": "freerange",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "freerange",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.freerangehomeschool",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.freerangehomeschool"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Freerange",
      "themeColor": "#2F6B5E",
      "backgroundColor": "#FBF8F3",
      "shortName": "Freerange",
      "description": "Freerange: Homeschooling Outside The Box"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F6B5E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Freerange uses your photos to add work samples and receipts to your homeschool portfolio.",
          "cameraPermission": "Freerange uses the camera so kids and parents can snap work samples for the portfolio.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Freerange: Homeschooling Outside The Box. A flexible homeschool planner for every kid, with a curriculum marketplace, a creator studio, and a local community."
  }
}
